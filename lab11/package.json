{
  "name": "tasklist-api",
  "version": "1.0.0",
  "description": "REST API «Список задач» на Node.js + Express + PostgreSQL (практическая работа 11, вариант 1)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
