# Скопируйте файл в .env и укажите свои параметры подключения
PORT=3011
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lab11_tasks
DB_USER=postgres
DB_PASSWORD=your_password
# База для автотестов (очищается и заполняется заново при каждом запуске npm test)
DB_NAME_TEST=lab11_tasks_test
# Адрес React-клиента, которому разрешены запросы (CORS)
CORS_ORIGIN=http://localhost:5311
