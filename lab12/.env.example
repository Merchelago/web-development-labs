# Скопируйте файл в .env и укажите свои параметры подключения
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lab12_tasks
DB_USER=postgres
DB_PASSWORD=your_password

# Порт Flask-сервера и режим отладки
PORT=5012
FLASK_DEBUG=0

# Адреса клиентских приложений (React и т.п.), которым разрешён доступ к API (через запятую)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
