# Параметры подключения к PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lab14_safevision
DB_USER=postgres
DB_PASSWORD=your_password

# HTTP-сервер API
PORT=3014
# Секрет для подписи JWT-токенов (замените на длинную случайную строку)
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=12h
# Адрес клиентского приложения (для CORS)
CLIENT_ORIGIN=http://localhost:5314
